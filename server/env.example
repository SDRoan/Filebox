PORT=5001
MONGODB_URI=mongodb://localhost:27017/filebox
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
CLIENT_URL=http://localhost:3000
# For production, add multiple origins separated by commas
# ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app,https://your-custom-domain.com

# Email Configuration (for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Integration OAuth Credentials
MICROSOFT_TEAMS_CLIENT_ID=your-microsoft-teams-client-id
MICROSOFT_TEAMS_CLIENT_SECRET=your-microsoft-teams-client-secret
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# File Box AI — local only. Everything below runs on your machine through Ollama.
# File storage, sharing and search keep working when Ollama is stopped.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_OCR_MODEL=glm-ocr
OLLAMA_SUMMARY_MODEL=llama3.1:8b
OLLAMA_ASSISTANT_MODEL=llama3.1:8b
OLLAMA_ASSISTANT_PLANNER_MODEL=llama3.1:8b
OLLAMA_ASSISTANT_TEMPERATURE=0.25
OLLAMA_ASSISTANT_HISTORY_TURNS=8
OLLAMA_ASSISTANT_MAX_FILE_CONTEXT_CHARS=12000
OLLAMA_TIMEOUT_MS=120000
OLLAMA_FALLBACK_ENABLED=true             # Fall back to Tesseract OCR when Ollama OCR is unavailable

# Student features (courses, assignments, study groups, forums, learning library)
# are hidden from File Box. Set to true to re-enable their API routes locally.
FILEBOX_ENABLE_STUDENT_FEATURES=false
